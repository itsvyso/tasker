{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasker",
  "version": "1.0.0",
  "identifier": "com.tasker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tasker Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IHRhc2tlci11cGRhdGVyClJXRVpQMW1kY2xKREpBMXFzQk90WkpVRWl0Qk1jY01WNDhWQXcxbjJKV3pQU1Zpdk5aN1JqK1gK",
      "endpoints": [
        "https://github.com/itsvy/tasker/releases/latest/download/latest.json"
      ]
    }
  }
}
